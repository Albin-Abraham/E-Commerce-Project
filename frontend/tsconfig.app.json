{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["*"],
      "@features": ["features/index"],
      "@features/*": ["features/*"],
      "@shared": ["shared/index"],
      "@shared/*": ["shared/*"],
      "@shell": ["shell/index"],
      "@shell/*": ["shell/*"],
      "@core": ["core/index"],
      "@core/*": ["core/*"],
      "@ui": ["shared/ui/index"],
      "@ui/*": ["shared/ui/*"],
      "@components/*": ["shared/ui/*"],
      "@hooks": ["shared/hooks/index"],
      "@hooks/*": ["shared/hooks/*"],
      "@utils/*": ["shared/utils/*"],
      "@constants/*": ["shared/constants/*"],
      "@assets/*": ["shared/assets/*"],
      "@styles/*": ["shared/styles/*"],
      "@testing/*": ["shared/testing/*"],
      "@libs/*": ["core/libs/*"],
      "@contexts/*": ["core/contexts/*"],
      "@configs/*": ["core/configs/*"],
      "@debug/*": ["core/debug/*"],
      "@i18n/*": ["core/i18n/*"],
      "@services/*": ["core/services/*"],
      "@stores/*": ["core/state/*"],
      "@pages/*": ["shell/pages/*"],
      "@form-core": ["core/form-core"],
      "@form-core/*": ["core/form-core/*"],
      "@form-core/testing": ["core/form-core/test-utils"],
      "@table-core": ["core/table-core"],
      "@table-core/*": ["core/table-core/*"],
      "@table-core/testing": ["core/table-core/test-utils"],
      "@form-ui": ["shared/ui/form/components"],
      "@form-ui/*": ["shared/ui/form/components/*"],
      "@table-ui": ["shared/ui/table/ui"],
      "@table-ui/*": ["shared/ui/table/ui/*"],
      "@form-hooks": ["shared/ui/form/hooks"],
      "@form-hooks/*": ["shared/ui/form/hooks/*"],
      "@table-hooks": ["shared/ui/table/hooks"],
      "@table-hooks/*": ["shared/ui/table/hooks/*"]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
