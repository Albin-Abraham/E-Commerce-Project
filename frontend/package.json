{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "scaffold": "node scripts/scaffold.js",
    "scaffold:form": "node scripts/scaffold.js zenos-form",
    "env:init": "node scripts/ensure-env.js",
    "env:init:force": "node scripts/ensure-env.js --force",
    "env:check": "node scripts/ensure-env.js --check",
    "dockerignore:sync": "node scripts/sync-dockerignore.js",
    "dockerignore:check": "node scripts/sync-dockerignore.js --check",
    "dev": "vite",
    "build": "node scripts/build_app.js",
    "tokens:build": "node --import=tsx scripts/build-tokens.ts",
    "tokens:validate": "node --import=tsx scripts/validate-tokens.ts",
    "tokens:check": "npx pnpm tokens:validate && node scripts/check-tokens.cjs",
    "predev": "npx pnpm tokens:build && npx pnpm tokens:check && node scripts/ensure-env.js",
    "pretest": "node scripts/ensure-env.js",
    "prebuild": "npx pnpm tokens:build && npx pnpm tokens:check && node scripts/ensure-env.js",
    "build:all": "npx pnpm lint && npx pnpm test && npx pnpm build",
    "vercel-build": "npx pnpm build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:form-core": "vitest run --project form-core",
    "test:table-core": "vitest run --project table-core",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:mdap": "vitest run --project mdap",
    "test:shared-testing": "vitest run --project shared-testing",
    "test:core": "pnpm test:form-core && pnpm test:table-core",
    "test:all": "pnpm test:unit && pnpm test:form-core && pnpm test:table-core && pnpm test:component && pnpm test:integration && pnpm test:mdap && pnpm test:shared-testing",
    "test:changed": "node --import=tsx scripts/test/test-changed.ts",
    "test:changed:json": "node --import=tsx scripts/test/test-changed.ts --json --output=test-results/affected-tests.json",
    "test:watch:unit": "vitest --project unit --watch",
    "test:watch:form": "vitest --project form-core --watch",
    "test:watch:table": "vitest --project table-core --watch",
    "test:watch:component": "vitest --project component --watch",
    "test:coverage": "vitest run --coverage",
    "test:form-core:coverage": "vitest run -c projects/form-core/vitest.config.ts --coverage",
    "test:coverage:merge": "vitest run --coverage --merge",
    "test:coverage:diff": "node --import=tsx scripts/test/coverage-diff.ts",
    "test:quality-gates": "node --import=tsx scripts/test/quality-gates.ts",
    "test:ui": "vitest --ui",
    "test:regression": "vitest run --testNamePattern=\"regression|Regression\"",
    "test:scenario": "vitest run scenario.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test e2e/specs/form-snapshots.spec.ts",
    "test:visual:update": "playwright test e2e/specs/form-snapshots.spec.ts --update-snapshots",
    "test:a11y": "playwright test e2e/specs/accessibility.spec.ts",
    "fixture:view": "node scripts/fixtures/msw-fixture-manager.js view",
    "fixture:inspect": "node scripts/fixtures/msw-fixture-manager.js inspect",
    "fixture:generate": "node scripts/fixtures/msw-fixture-manager.js generate",
    "fixture:fetch": "node scripts/fixtures/msw-fixture-manager.js fetch",
    "fixture:delete": "node scripts/fixtures/msw-fixture-manager.js delete",
    "analyze": "node scripts/analyze.js",
    "budget:check": "node scripts/bundle-budget.mjs",
    "release:report": "node scripts/release-report.mjs",
    "deps:check": "pnpm dlx audit-ci@7.1.0 --config ./audit-ci.jsonc",
    "css:check": "npx tailwindcss --help > /dev/null && echo 'Tailwind CLI detected' || echo 'Tailwind CLI not found'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "i18n:sync": "node scripts/i18n/i18n-sync.js",
    "api:sync": "node scripts/sync-api-schema.js",
    "test:report:context": "node scripts/test/generate-test-context.js",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@xstate/react": "^6.0.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "email-validator": "^2.0.4",
    "figlet": "^1.12.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.0",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.13.3",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.552.0",
    "papaparse": "^5.5.4",
    "qs": "^6.16.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.10.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "validator": "^13.15.35",
    "xstate": "^5.28.0",
    "yup": "^1.7.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.36.0",
    "@faker-js/faker": "^10.5.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-onboarding": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/react-vite": "^10.2.17",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/figlet": "^1.7.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "cli-cursor": "^5.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-storybook": "^10.2.17",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.4.0",
    "inquirer": "^14.0.2",
    "jsdom": "^27.0.1",
    "msw": "^2.15.0",
    "node-plop": "^0.32.3",
    "ora": "^9.0.0",
    "playwright": "^1.58.2",
    "plop": "^4.0.4",
    "prettier": "^3.8.1",
    "restore-cursor": "^5.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.101.0",
    "storybook": "^10.2.17",
    "style-dictionary": "^5.7.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
