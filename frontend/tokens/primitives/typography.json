{
  "primitives": {
    "typography": {
      "fontFamily": {
        "sans": {
          "$value": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "$type": "fontFamily"
        },
        "mono": {
          "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "$type": "fontFamily"
        }
      },
      "fontWeight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "normal": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" },
        "black": { "$value": "900", "$type": "fontWeight" }
      },
      "fontSize": {
        "xs": { "$value": "12px", "$type": "dimension" },
        "sm": { "$value": "14px", "$type": "dimension" },
        "md": { "$value": "16px", "$type": "dimension" },
        "base": { "$value": "16px", "$type": "dimension" },
        "lg": { "$value": "18px", "$type": "dimension" },
        "xl": { "$value": "20px", "$type": "dimension" },
        "2xl": { "$value": "24px", "$type": "dimension" },
        "3xl": { "$value": "30px", "$type": "dimension" },
        "4xl": { "$value": "36px", "$type": "dimension" },
        "5xl": { "$value": "48px", "$type": "dimension" },
        "6xl": { "$value": "60px", "$type": "dimension" }
      },
      "lineHeight": {
        "tight": { "$value": "1.2", "$type": "dimension" },
        "snug": { "$value": "1.3", "$type": "dimension" },
        "normal": { "$value": "1.5", "$type": "dimension" },
        "relaxed": { "$value": "1.7", "$type": "dimension" }
      },
      "letterSpacing": {
        "tight": { "$value": "-0.02em", "$type": "dimension" },
        "normal": { "$value": "0", "$type": "dimension" },
        "wide": { "$value": "0.02em", "$type": "dimension" },
        "tighter": { "$value": "-0.04em", "$type": "dimension" },
        "widest": { "$value": "0.1em", "$type": "dimension" }
      }
    }
  }
}
