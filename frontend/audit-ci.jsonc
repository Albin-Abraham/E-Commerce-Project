  // audit-ci configuration - dependency advisory gate for pull requests.
  //
  // Policy (adopted 2026-10-24):
  //   * HIGH and CRITICAL advisories block the PR.
  //   * The entries below are the pre-existing baseline (62 unique GHSAs,
  //     covering 75 advisory paths) captured when the gate was introduced.
  //     They are grandfathered so the gate is meaningful from day one:
  //     it fails only on NEW high/critical advisories.
  //   * Burn-down order: runtime dependencies first (axios, react-router,
  //     zod - these ship to users), then dev tooling. Upgrading a module
  //     usually clears several entries at once; delete the stale lines
  //     from this file in the same PR so "show-found" stays truthful.
  //   * Do not add module-name allowlist records ("axios" as a bare string):
  //     they suppress all future advisories for that module. GHSA IDs only.
  //
  // CI: .github/workflows/pr-validation.yml -> "Audit dependencies" step
  //     (pnpm dlx audit-ci@7.1.0, pinned; runs before any pnpm install so a
  //     compromised postinstall cannot execute before the scan).
  // Local: pnpm deps:check
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Threshold: "high" fails the run on high or critical (moderate/low report only).
  "high": true,
  "package-manager": "pnpm",
  "report-type": "important",
