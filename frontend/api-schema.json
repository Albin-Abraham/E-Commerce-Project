components:
  schemas:
    Branch:
      type: object
      description: |-
        Base ModelSerializer that includes GoF Domain Validation patterns,
        dynamic field tailoring, and recursive context propagation.
      properties:
        id:
          type: string
          readOnly: true
        company:
          type: string
          nullable: true
        business_unit:
          type: string
          description: '[Rules: Required]'
        name:
          type: string
          description: '[Rules: Required, MinLength(3)]'
          maxLength: 255
        code:
          type: string
          description: '[Rules: Required]'
          maxLength: 20
        location:
          type: string
          maxLength: 255
        opened_date:
          type: string
          format: date
        catalog:
          type: string
          nullable: true
          description: The subscription tier/catalog applied to this branch
        extensions:
          $ref: '#/components/schemas/BranchExtension'
      required:
      - business_unit
      - code
      - id
      - location
      - name
      - opened_date
    BranchExtension:
      type: object
      description: |-
        Base ModelSerializer that includes GoF Domain Validation patterns,
        dynamic field tailoring, and recursive context propagation.
      properties:
        extra_attributes: {}
    BranchExtensionRequest:
      type: object
      description: |-
        Base ModelSerializer that includes GoF Domain Validation patterns,
        dynamic field tailoring, and recursive context propagation.
      properties:
        extra_attributes: {}
    BranchRequest:
      type: object
      description: |-
        Base ModelSerializer that includes GoF Domain Validation patterns,
        dynamic field tailoring, and recursive context propagation.
      properties:
        company:
          type: string
          minLength: 1
          nullable: true
        business_unit:
          type: string
          minLength: 1
          description: '[Rules: Required]'
        name:
          type: string
          minLength: 1
          description: '[Rules: Required, MinLength(3)]'
          maxLength: 255
        code:
          type: string
          minLength: 1
          description: '[Rules: Required]'
          maxLength: 20
        location:
          type: string
          minLength: 1
          maxLength: 255
        opened_date:
          type: string
          format: date
        catalog:
          type: string
          minLength: 1
          nullable: true
          description: The subscription tier/catalog applied to this branch
        extensions:
          $ref: '#/components/schemas/BranchExtensionRequest'
      required:
      - business_unit
      - code
      - location
      - name
      - opened_date
    BranchSerializerSingleResponse:
      type: object
      properties:
        meta:
          type: object
          additionalProperties: {}
          description: Optional metadata such as validation_trace when ?explain=true
            is used
        success:
          type: boolean
          default: true
        message:
          type: string
          default: Fetched successfully
        data:
          $ref: '#/components/schemas/Branch'
      required:
      - data
    BusinessUnit:
      type: object
