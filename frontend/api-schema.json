openapi: 3.0.3
info:
  title: Zenith Platform API
  version: 1.0.0
  description: Industrialized Backend-RestFul architecture featuring Multi-tenant
    context, Rules Engine validation, and Hybrid JWT/Session authentication.
paths:
  /api/admin/branches/:
    get:
      operationId: admin_branches_retrieve
      description: Retrieve a single branch record.
      summary: GET Branch
      parameters:
      - in: header
        name: Is-Select-Option
        schema:
          type: boolean
        description: Return only ID and None using select_serializer_class (skips
          pagination)
      - in: query
        name: explain
        schema:
          type: boolean
        description: Enable validation trace debugging (for bulk actions/advanced
          tracing). When true, the response meta object will contain detailed execution
          traces.
      - in: query
        name: fields
        schema:
          type: string
        description: Comma-separated list of fields to include in the response
      - in: query
        name: ids
        schema:
          type: string
        description: Comma-separated list of IDs to include (Bulk Selection)
      - in: query
        name: include_ids
        schema:
          type: string
        description: Comma-separated list of IDs to always include in select results
          (ignored if search is active)
      - in: query
        name: query
        schema:
          type: string
        description: 'Advanced JSON-based filtering payload (Stringified). Supports
          nested {''AND'': [...]}, {''OR'': [...]}, and Cross-field/Self-references
          using {''F'': {''field__lt'': ''other_field''}}.'
      - in: query
        name: select_limit
        schema:
          type: integer
        description: 'Limit the number of results for select requests (default: 10)'
      - in: query
        name: selected_ids
        schema:
          type: string
        description: Alias for 'ids' (Bulk Selection)
      - in: query
        name: update
        schema:
          type: boolean
        description: Return create/update serializer (for update form display)
      tags:
      - Branch
      security:
      - PlatformAuth: []
      - cookieAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BranchSerializerSingleResponse'
          description: Success response with single object
        '404':
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: Branch not found
          description: Resource not found
    post:
      operationId: admin_branches_create
      description: "Create a new branch record.\n\nValidation: validate_create() hook
        will be called before processing.\n\n---\n\n### \U0001F6E1️ Validation Rules
        (Mediator)\n\n**`business_unit`**:\n- `RequiredRule`: business_unit is required.
        *(Code: required)*\n- `RelationKeyRule`: Business Unit must belong to the
        selected Company *(Code: relation_invalid)*\n\n**`name`**:\n- `RequiredRule`:
        name is required. *(Code: required)*\n- `MinRule`: name must be at least 3.
        *(Code: min)*\n- `UniqueRule`: name already exists. *(Code: unique)*\n\n**`code`**:\n-
        `RequiredRule`: code is required. *(Code: required)*\n- `UniqueRule`: code
        already exists. *(Code: unique)*\n"
      summary: POST Branch
      parameters:
      - in: query
        name: explain
        schema:
          type: boolean
        description: Enable ValidationMediator trace debugging. When true, the response
          meta object will contain detailed execution traces.
      tags:
      - Branch
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BranchRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/BranchRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BranchRequest'
        required: true
      security:
      - PlatformAuth: []
      - cookieAuth: []
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BranchSerializerSingleResponse'
          description: Created successfully
        '422':
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: Validation failed
                  details:
                    type: object
                    properties:
                      errors:
                        type: object
                        additionalProperties:
                          type: array
                          items:
                            type: string
                        example:
                          field_name:
                          - This field is required.
                          email:
                          - Enter a valid email address.
          description: Validation failed
        '400':
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: No data in request
                  details:
                    type: object
                    properties:
                      error:
                        type: string
          description: Bad request (no data provided)
        '500':
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: An error occurred while creating the record.
                  details:
                    type: object
                    properties:
                      error:
                        type: string
          description: Internal server error
