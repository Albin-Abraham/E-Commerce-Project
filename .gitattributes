# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force specific file types to LF
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite3 binary
*.pyc binary

# Export exclusions
.github export-ignore
.gitignore export-ignore
.pre-commit-config.yaml export-ignore
tests export-ignore
