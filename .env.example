# ------------------------------------------------------------------------------
# Global Configuration
# ------------------------------------------------------------------------------
TZ=UTC  # Options: UTC, Asia/Kolkata, etc.
TIME_ZONE=UTC

# ------------------------------------------------------------------------------
# Django Configuration
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=backend.settings.dev
SECRET_KEY=django-insecure-change-me-in-production-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# ------------------------------------------------------------------------------
# Primary Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Specific variables for the Docker Postgres container

POSTGRES_DB=backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Shared URL for Django (used by django-environ)

DATABASE_URL=postgres://postgres:postgres@postgres:5432/backend_db


# ------------------------------------------------------------------------------
# Redis, Cache, and Celery
# ------------------------------------------------------------------------------
# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Django Cache (uses REDIS_URL/1 by convention if needed)
CACHE_URL=redis://redis:6379/1

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# JWT & Security
# ------------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1
TIME_ZONE=UTC

# ------------------------------------------------------------------------------
# Industrialization & Infrastructure Control
# ------------------------------------------------------------------------------
# Toggle for the Redis metadata cache
METADATA_CACHE_ENABLED=True
# TTL for model rule metadata in seconds (1 hour default)
METADATA_CACHE_TTL=3600
# Number of records to trigger an asynchronous Celery task instead of sync processing
BULK_OPERATION_THRESHOLD=50
# Default rate limit for the TenantDynamicThrottle
THROTTLE_RATE_DEFAULT=1000/day
# Rate limit for the background bulk operation task
CELERY_TASK_RATE_LIMIT=50/m

# ------------------------------------------------------------------------------
# Payment Gateways (Fallback Credentials for Non-DB Mode)
# ------------------------------------------------------------------------------
# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# PayPal Credentials
PAYPAL_CLIENT_ID=paypal_client_id_placeholder
PAYPAL_CLIENT_SECRET=paypal_client_secret_placeholder
PAYPAL_MODE=sandbox  # Options: sandbox, live

# ------------------------------------------------------------------------------
# Core External Services (GCP, Firebase, SMTP)
# ------------------------------------------------------------------------------
# Google Cloud Platform & Storage
GOOGLE_STORAGE_BUCKET_NAME=yafei-platform-assets
GOOGLE_API_KEY=AIzaSy_placeholder_key
GOOGLE_CLIENT_ID=placeholder_oauth_client_id.apps.googleusercontent.com

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_JSON=  # Optional: Inline JSON string of service account key
FIREBASE_CREDENTIALS_PATH=  # Optional: /path/to/service-account.json

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=app_specific_password_here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="No-Reply <noreply@example.com>"
